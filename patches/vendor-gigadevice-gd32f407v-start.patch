diff --git a/boards/gd32f4/gd32f470v_start/src/gd32f4xx_fireeye_hw.c b/boards/gd32f4/gd32f470v_start/src/gd32f4xx_fireeye_hw.c
new file mode 100644
index 0000000..4907642
--- /dev/null
+++ b/boards/gd32f4/gd32f470v_start/src/gd32f4xx_fireeye_hw.c
@@ -0,0 +1,446 @@
+/****************************************************************************
+ * vendor/gigadevice/boards/gd32f4/gd32f470v_start/src/gd32f4xx_fireeye_hw.c
+ *
+ * 火眼（FireEye）板级硬件接口：ADC 采样 + 报警输出 + 按键 + I2C1 注册。
+ *
+ * 为什么写在板级：
+ *   openvela/nuttx 目前没有 GD32F4 的 ADC 驱动，也没有 ADC 寄存器头文件。
+ *   这里按照《GD32F4xx User Manual Rev3.4》第 14 章（ADC）直接操作寄存器，
+ *   对上层应用（app/fireeye）只暴露"采样/输出"这样的简单接口。
+ *
+ * 寄存器依据（UM Rev3.4）：
+ *   14.7.1  ADC_STAT   offset 0x000 : bit5 ROVF / bit4 STRC / bit1 EOC / bit0 WDE
+ *   14.7.2  ADC_CTL0   offset 0x004 : bit25:24 DRES(00=12bit) / bit8 SM / bit5 EOCIE
+ *   14.7.3  ADC_CTL1   offset 0x008 : bit30 SWRCST / bit11 DAL / bit10 EOCM /
+ *                                     bit8 DMA / bit3 RSTCLB / bit2 CLB / bit1 CTN /
+ *                                     bit0 ADCON
+ *   14.7.4  ADC_SAMPT0 offset 0x00C : 通道 10..18 采样时间（每个 3 bit）
+ *   14.7.5  ADC_SAMPT1 offset 0x010 : 通道 0..9 采样时间（每个 3 bit）
+ *                                     000=3 001=15 010=28 011=56 100=84 101=112
+ *                                     110=144 111=480 CK_ADC 周期
+ *   14.7.8  ADC_RSQ0   offset 0x02C : bit23:20 RL[3:0]，转换次数 = RL + 1
+ *   14.7.10 ADC_RSQ2   offset 0x034 : bit4:0 RSQ0[4:0]，序列第 1 个转换通道
+ *   14.7.11 ADC_RDATA  offset 0x04C : bit15:0 转换结果
+ *   14.7.14 ADC_SYNCCTL offset 0x304: bit18:16 ADCCK[2:0]，000=PCLK2/2 … 011=PCLK2/8
+ *   4.3.14  RCU_APB2EN offset 0x044 : bit8 ADC0EN
+ *   14.4.1  校准流程：ADCON=1 → 延时 → RSTCLB 置 1 等硬件清零 → CLB 置 1 等硬件清零
+ *
+ * 接线（详见 docs/开发板接线.md）：
+ *   PA4 = ADC0_IN4  电流（ACS712 输出经 1/2 分压）
+ *   PA6 = ADC0_IN6  温度（10kΩ 上拉 + NTC 到地，中点进 ADC）
+ *   PB0 = 继电器 IN
+ *   PB1 = 蜂鸣器 +
+ *   PA0 = 板载按键 K2（按下为低电平）
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <errno.h>
+#include <unistd.h>
+
+#include <nuttx/i2c/i2c_master.h>
+
+#include <arch/board/board.h>
+
+#include "gd32f4xx_gpio.h"
+#include "gd32f4xx_i2c.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* ADC0 与相关寄存器（UM 14.7） */
+
+#define FIREEYE_ADC0_BASE        0x40012000u
+#define FIREEYE_ADC_STAT         (FIREEYE_ADC0_BASE + 0x000)
+#define FIREEYE_ADC_CTL0         (FIREEYE_ADC0_BASE + 0x004)
+#define FIREEYE_ADC_CTL1         (FIREEYE_ADC0_BASE + 0x008)
+#define FIREEYE_ADC_SAMPT0       (FIREEYE_ADC0_BASE + 0x00c)
+#define FIREEYE_ADC_SAMPT1       (FIREEYE_ADC0_BASE + 0x010)
+#define FIREEYE_ADC_RSQ0         (FIREEYE_ADC0_BASE + 0x02c)
+#define FIREEYE_ADC_RSQ2         (FIREEYE_ADC0_BASE + 0x034)
+#define FIREEYE_ADC_RDATA        (FIREEYE_ADC0_BASE + 0x04c)
+#define FIREEYE_ADC_SYNCCTL      (FIREEYE_ADC0_BASE + 0x304)
+
+/* RCU：ADC0 时钟使能（UM 4.3.14，offset 0x44，bit8） */
+
+#define FIREEYE_RCU_APB2EN       0x40023844u
+#define FIREEYE_RCU_ADC0EN       (1u << 8)
+
+/* ADC_STAT 位 */
+
+#define FIREEYE_ADC_STAT_EOC     (1u << 1)
+
+/* ADC_CTL0 位 */
+
+#define FIREEYE_ADC_CTL0_DRES12  (0u << 24)   /* 12bit 分辨率 */
+
+/* ADC_CTL1 位 */
+
+#define FIREEYE_ADC_CTL1_ADCON   (1u << 0)
+#define FIREEYE_ADC_CTL1_CLB     (1u << 2)
+#define FIREEYE_ADC_CTL1_RSTCLB  (1u << 3)
+#define FIREEYE_ADC_CTL1_SWRCST  (1u << 30)
+
+/* ADC_SYNCCTL：ADCCK[2:0]，001 = PCLK2 / 4 */
+
+#define FIREEYE_ADC_ADCCK_SHIFT  16
+#define FIREEYE_ADC_ADCCK_DIV4   (1u << FIREEYE_ADC_ADCCK_SHIFT)
+
+/* 采样时间编码：111 = 480 CK_ADC 周期（分压源阻抗约 5kΩ，取最长） */
+
+#define FIREEYE_ADC_SPT_480      7u
+
+/* 超时计数（轮询等待，失败即报错，不静默继续） */
+
+#define FIREEYE_ADC_TIMEOUT      200000
+
+/* 引脚定义：PA4/PA6 模拟输入，PB0 继电器，PB1 蜂鸣器，PA0 按键 */
+
+#define GPIO_FIREEYE_CURRENT     (GPIO_CFG_MODE_ANALOG | GPIO_CFG_PUPD_NONE | \
+                                  GPIO_CFG_PORT_A | GPIO_CFG_PIN_4)
+#define GPIO_FIREEYE_TEMP        (GPIO_CFG_MODE_ANALOG | GPIO_CFG_PUPD_NONE | \
+                                  GPIO_CFG_PORT_A | GPIO_CFG_PIN_6)
+#define GPIO_FIREEYE_RELAY       (GPIO_CFG_MODE_OUTPUT | GPIO_CFG_PUPD_NONE | \
+                                  GPIO_CFG_PP | GPIO_CFG_SPEED_2MHZ | \
+                                  GPIO_CFG_PORT_B | GPIO_CFG_PIN_0)
+#define GPIO_FIREEYE_BUZZER      (GPIO_CFG_MODE_OUTPUT | GPIO_CFG_PUPD_NONE | \
+                                  GPIO_CFG_PP | GPIO_CFG_SPEED_2MHZ | \
+                                  GPIO_CFG_PORT_B | GPIO_CFG_PIN_1)
+#define GPIO_FIREEYE_KEY         (GPIO_CFG_MODE_INPUT | GPIO_CFG_PUPD_PULLUP | \
+                                  GPIO_CFG_PORT_A | GPIO_CFG_PIN_0)
+
+/* 报警灯模块（3 脚：VCC 5V / GND / IN）信号脚 */
+
+#define GPIO_FIREEYE_ALARM_LED   (GPIO_CFG_MODE_OUTPUT | GPIO_CFG_PUPD_NONE | \
+                                  GPIO_CFG_PP | GPIO_CFG_SPEED_2MHZ | \
+                                  GPIO_CFG_PORT_D | GPIO_CFG_PIN_9)
+
+/* 报警灯触发极性：1 = 高电平点亮；若实测反了改成 0 */
+
+#define FIREEYE_LED_ACTIVE_HIGH  1
+
+/* 继电器模块（JQC-3FF-S-Z，5V 线圈）一般是低电平触发：
+ * 引脚输出低 -> 线圈得电 -> 常开触点闭合/常闭断开。
+ * 若实测相反，把下面的宏改成 0 即可。 */
+
+/* 实机验证（2026-09-13）：S=NORMAL 时风扇停转 ⇒ 该模块为低电平触发，置 1 */
+#define FIREEYE_RELAY_ACTIVE_LOW  1
+
+/* 蜂鸣器为高电平响（有源蜂鸣器模块） */
+
+/* 实机验证（2026-09-13）：蜂鸣器模块为低电平触发，故置 0 */
+#define FIREEYE_BUZZER_ACTIVE_HIGH  0
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* 板级代码里不方便引入 arm_internal.h，就地做寄存器读写 */
+
+static uint32_t fireeye_reg_read(uintptr_t addr)
+{
+  return *(volatile uint32_t *)addr;
+}
+
+static void fireeye_reg_write(uintptr_t addr, uint32_t value)
+{
+  *(volatile uint32_t *)addr = value;
+}
+
+static void fireeye_reg_setbits(uintptr_t addr, uint32_t bits)
+{
+  fireeye_reg_write(addr, fireeye_reg_read(addr) | bits);
+}
+
+static void fireeye_reg_clrset(uintptr_t addr, uint32_t clr, uint32_t set)
+{
+  fireeye_reg_write(addr, (fireeye_reg_read(addr) & ~clr) | set);
+}
+
+/* 等待某位被硬件清零，带超时（fail-fast） */
+
+static int fireeye_wait_clear(uintptr_t addr, uint32_t bits)
+{
+  int i;
+
+  for (i = 0; i < FIREEYE_ADC_TIMEOUT; i++)
+    {
+      if ((fireeye_reg_read(addr) & bits) == 0)
+        {
+          return 0;
+        }
+    }
+
+  return -ETIMEDOUT;
+}
+
+static void fireeye_led(bool on)
+{
+  /* 板载 LED2：PC6，高电平点亮（原理图 GD32407V-START-V1.1） */
+
+  gd32_gpio_write(GPIO_CFG_MODE_OUTPUT | GPIO_CFG_PUPD_NONE | GPIO_CFG_PP |
+                  GPIO_CFG_SPEED_2MHZ | GPIO_CFG_PORT_C | GPIO_CFG_PIN_6, on);
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: gd32_fireeye_hw_initialize
+ *
+ * Description:
+ *   初始化火眼用到的板级硬件：ADC0（电流/温度）、报警输出（蜂鸣器/继电器）、
+ *   按键输入、板载 LED。
+ *
+ * Returned Value:
+ *   0 表示成功，负值为错误码。
+ *
+ ****************************************************************************/
+
+int gd32_fireeye_hw_initialize(void)
+{
+  int ret;
+  uint32_t ctl1;
+
+  /* --- 1) ADC0 时钟与时钟分频 --- */
+
+  fireeye_reg_setbits(FIREEYE_RCU_APB2EN, FIREEYE_RCU_ADC0EN);
+
+  /* PCLK2 = 84MHz，ADCCK = PCLK2/4 = 21MHz（手册上限 40MHz） */
+
+  fireeye_reg_clrset(FIREEYE_ADC_SYNCCTL, (7u << FIREEYE_ADC_ADCCK_SHIFT),
+                     FIREEYE_ADC_ADCCK_DIV4);
+
+  /* --- 2) 引脚：PA4/PA6 模拟输入，PB0/PB1 输出，PA0 输入 --- */
+
+  gd32_gpio_config(GPIO_FIREEYE_CURRENT);
+  gd32_gpio_config(GPIO_FIREEYE_TEMP);
+  gd32_gpio_config(GPIO_FIREEYE_RELAY);
+  gd32_gpio_config(GPIO_FIREEYE_BUZZER);
+  gd32_gpio_config(GPIO_FIREEYE_KEY);
+  gd32_gpio_config(GPIO_FIREEYE_ALARM_LED);
+
+  /* 默认输出：继电器不动作、蜂鸣器不响 */
+
+  gd32_fireeye_set_relay(false);
+  gd32_fireeye_set_buzzer(false);
+  gd32_fireeye_set_alarm_led(false);
+
+  /* --- 3) ADC 基本配置：12bit、非扫描、单次转换 --- */
+
+  fireeye_reg_write(FIREEYE_ADC_CTL0, FIREEYE_ADC_CTL0_DRES12);
+  fireeye_reg_write(FIREEYE_ADC_CTL1, 0);
+
+  /* --- 4) ADC 上电 --- */
+
+  fireeye_reg_setbits(FIREEYE_ADC_CTL1, FIREEYE_ADC_CTL1_ADCON);
+  usleep(2000);
+
+  /* --- 5) 前台校准：RSTCLB → CLB（UM 14.4.1） --- */
+
+  ctl1 = fireeye_reg_read(FIREEYE_ADC_CTL1);
+  fireeye_reg_write(FIREEYE_ADC_CTL1, ctl1 | FIREEYE_ADC_CTL1_RSTCLB);
+  ret = fireeye_wait_clear(FIREEYE_ADC_CTL1, FIREEYE_ADC_CTL1_RSTCLB);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  fireeye_reg_setbits(FIREEYE_ADC_CTL1, FIREEYE_ADC_CTL1_CLB);
+  ret = fireeye_wait_clear(FIREEYE_ADC_CTL1, FIREEYE_ADC_CTL1_CLB);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  fireeye_led(false);
+  return 0;
+}
+
+/****************************************************************************
+ * Name: gd32_fireeye_adc_sample
+ *
+ * Description:
+ *   单通道单次转换，返回 0~4095 的原始码值（12bit）。
+ *
+ * Input Parameters:
+ *   channel - ADC 通道号（0~18）。电流用 4（PA4），温度用 6（PA6）。
+ *
+ * Returned Value:
+ *   非负：转换结果；负值：错误码。
+ *
+ ****************************************************************************/
+
+int gd32_fireeye_adc_sample(int channel)
+{
+  uintptr_t sampt;
+  uint32_t shift;
+  int i;
+
+  if (channel < 0 || channel > 18)
+    {
+      return -EINVAL;
+    }
+
+  /* 采样时间：480 周期 */
+
+  if (channel < 10)
+    {
+      sampt = FIREEYE_ADC_SAMPT1;
+      shift = (uint32_t)(3 * channel);
+    }
+  else
+    {
+      sampt = FIREEYE_ADC_SAMPT0;
+      shift = (uint32_t)(3 * (channel - 10));
+    }
+
+  fireeye_reg_clrset(sampt, (7u << shift), (FIREEYE_ADC_SPT_480 << shift));
+
+  /* 序列长度 = 1（RL=0），序列第 1 个通道 = channel */
+
+  fireeye_reg_clrset(FIREEYE_ADC_RSQ0, (0xfu << 20), 0);
+  fireeye_reg_clrset(FIREEYE_ADC_RSQ2, 0x1fu, (uint32_t)channel);
+
+  /* 清标志后软件触发（EOC/STRC 为 rc_w0，写 0 清除） */
+
+  fireeye_reg_write(FIREEYE_ADC_STAT, 0);
+  fireeye_reg_setbits(FIREEYE_ADC_CTL1, FIREEYE_ADC_CTL1_SWRCST);
+
+  for (i = 0; i < FIREEYE_ADC_TIMEOUT; i++)
+    {
+      if ((fireeye_reg_read(FIREEYE_ADC_STAT) & FIREEYE_ADC_STAT_EOC) != 0)
+        {
+          /* 读 RDATA 会同时清 EOC */
+
+          return (int)(fireeye_reg_read(FIREEYE_ADC_RDATA) & 0xffffu);
+        }
+    }
+
+  return -ETIMEDOUT;
+}
+
+/****************************************************************************
+ * Name: gd32_fireeye_set_buzzer / gd32_fireeye_set_relay
+ *
+ * Description:
+ *   控制蜂鸣器与继电器输出（含触发极性适配）。
+ *
+ ****************************************************************************/
+
+void gd32_fireeye_set_buzzer(bool on)
+{
+#if FIREEYE_BUZZER_ACTIVE_HIGH
+  gd32_gpio_write(GPIO_FIREEYE_BUZZER, on);
+#else
+  gd32_gpio_write(GPIO_FIREEYE_BUZZER, !on);
+#endif
+}
+
+void gd32_fireeye_set_relay(bool energized)
+{
+  /* energized = true 表示让继电器动作（切断负载） */
+
+#if FIREEYE_RELAY_ACTIVE_LOW
+  gd32_gpio_write(GPIO_FIREEYE_RELAY, !energized);
+#else
+  gd32_gpio_write(GPIO_FIREEYE_RELAY, energized);
+#endif
+}
+
+/****************************************************************************
+ * Name: gd32_fireeye_key_pressed
+ *
+ * Description:
+ *   读取板载按键（PA0）。板上 10kΩ 上拉、按下接地，因此按下为低电平。
+ *
+ ****************************************************************************/
+
+bool gd32_fireeye_key_pressed(void)
+{
+  return !gd32_gpio_read(GPIO_FIREEYE_KEY);
+}
+
+/****************************************************************************
+ * Name: gd32_fireeye_pin_raw
+ *
+ * Description:
+ *   直接设置某个输出引脚的电平（不做极性换算），用于型号确认/极性排查。
+ *
+ * Input Parameters:
+ *   which - 0=蜂鸣器(PB1) 1=继电器(PB0) 2=报警灯(PD9)
+ *   high  - true 输出高电平，false 输出低电平
+ *
+ ****************************************************************************/
+
+void gd32_fireeye_pin_raw(int which, bool high)
+{
+  switch (which)
+    {
+      case 0:
+        gd32_gpio_write(GPIO_FIREEYE_BUZZER, high);
+        break;
+
+      case 1:
+        gd32_gpio_write(GPIO_FIREEYE_RELAY, high);
+        break;
+
+      case 2:
+        gd32_gpio_write(GPIO_FIREEYE_ALARM_LED, high);
+        break;
+
+      default:
+        break;
+    }
+}
+
+/****************************************************************************
+ * Name: gd32_fireeye_set_alarm_led
+ *
+ * Description:
+ *   控制报警灯模块（PD9 = JP5 第 31 脚）。模块为 3 脚：VCC(5V)/GND/IN。
+ *
+ ****************************************************************************/
+
+void gd32_fireeye_set_alarm_led(bool on)
+{
+#if FIREEYE_LED_ACTIVE_HIGH
+  gd32_gpio_write(GPIO_FIREEYE_ALARM_LED, on);
+#else
+  gd32_gpio_write(GPIO_FIREEYE_ALARM_LED, !on);
+#endif
+}
+
+
+/****************************************************************************
+ * Name: gd32_fireeye_i2c_initialize
+ *
+ * Description:
+ *   注册 I2C1 字符设备（/dev/i2c1），供火眼 OLED（SSD1306）使用。
+ *   注意：I2C0 与 USART0 控制台共用 PB6/PB7，因此 OLED 走 I2C1（PB10/PB11）。
+ *
+ * Returned Value:
+ *   0 表示成功，负值为错误码。
+ *
+ ****************************************************************************/
+
+int gd32_fireeye_i2c_initialize(void)
+{
+  struct i2c_master_s *i2c;
+
+  i2c = gd32_i2cbus_initialize(1);
+  if (i2c == NULL)
+    {
+      return -ENODEV;
+    }
+
+  return i2c_register(i2c, 1);
+}
diff --git a/boards/gd32f4/gd32f470v_start/src/gd32f4xx_selftest.c b/boards/gd32f4/gd32f470v_start/src/gd32f4xx_selftest.c
new file mode 100644
index 0000000..79db4f0
--- /dev/null
+++ b/boards/gd32f4/gd32f470v_start/src/gd32f4xx_selftest.c
@@ -0,0 +1,285 @@
+/****************************************************************************
+ * vendor/gigadevice/boards/gd32f4/gd32f470v_start/src/gd32f4xx_selftest.c
+ *
+ * 火眼板级自检：不依赖串口，用板载 LED 判断系统到底有没有跑起来。
+ *
+ * 背景：串口长时间没有任何输出时，必须先区分两种情况——
+ *   (a) 芯片根本没跑起来（时钟/PLL 没锁、启动失败）；
+ *   (b) 芯片跑起来了，但串口这条链路（引脚/接线/USB-TTL）有问题。
+ *
+ * 板级依据（原理图 GD32407V-START-V1.1）：
+ *   - 板载 LED2：PC6 —— R10(470Ω) —— LED2 —— GND，高电平点亮；
+ *   - 板载按键 K2：PA0，外部 10kΩ 上拉到 3V3，按下为低电平。
+ *
+ * LED 指示含义（上电后依次出现）：
+ *   1) 2 次快闪：时钟已配置完成、固件跑到了板级早期初始化；
+ *   2) 5 次快闪：系统已进入应用初始化阶段（心跳线程已启动）；
+ *   3) 10 次极快闪烁：串口回环自检成功（仅当 PB6 与 PB7 被短接时才会出现）；
+ *   4) 之后 1Hz 心跳（亮 0.5s / 灭 0.5s）：系统完整跑起来了。
+ *      可用秒表核对周期：若明显变慢，说明实际晶振频率与配置不符；
+ *   5) 按住板载按键 K2 不放：LED 变成 5Hz 快闪，验证 GPIO 输入可用。
+ *
+ * 串口辅助（默认关闭）：
+ *   FIREYE_SELFTEST_UART=1 时，会绕过 NuttX 串口协议栈直接操作 USART0 寄存器：
+ *   每轮心跳发送 "FIREYE\r\n"，并在启动时做一次回环自检（临时关接收中断、
+ *   发送后轮询接收，PB6/PB7 短接时能收到则判定串口通路正常）。
+ *   注意：这套代码会与控制台驱动争用 USART0，仅在串口完全没输出时用于定位，
+ *   串口正常后必须保持为 0，否则会出现 NSH 横幅反复打印等异常。
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <unistd.h>
+
+#include <nuttx/board.h>
+#include <nuttx/kthread.h>
+
+#include "gd32f4xx_gpio.h"
+#include "hardware/gd32f4xx_uart.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* 板载 LED：PC6，高电平点亮 */
+
+#define FIREYE_LED_PIN  (GPIO_CFG_MODE_OUTPUT | GPIO_CFG_PUPD_NONE | GPIO_CFG_PP | \
+                         GPIO_CFG_SPEED_50MHZ | GPIO_CFG_PORT_C | GPIO_CFG_PIN_6)
+
+/* 板载按键：PA0，按下为低 */
+
+#define FIREYE_KEY_PIN  (GPIO_CFG_MODE_INPUT | GPIO_CFG_PUPD_PULLUP | \
+                         GPIO_CFG_PORT_A | GPIO_CFG_PIN_0)
+
+#define SELFTEST_THREAD_PRIO   100
+#define SELFTEST_THREAD_STACK  2048
+
+#define SELFTEST_LINE          "FIREYE\r\n"
+#define SELFTEST_LINE_LEN      8
+
+/* 1 = 启用"直接操作 USART0 寄存器"的诊断代码（会与控制台争用串口）；
+ * 串口已经通了，这里保持 0。 */
+
+#define FIREYE_SELFTEST_UART   0
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+#if FIREYE_SELFTEST_UART
+static bool g_loopback_ok;
+#endif
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static void fireye_led(bool on)
+{
+  gd32_gpio_write(FIREYE_LED_PIN, on);
+}
+
+static void fireye_led_flash(int times, useconds_t on_us, useconds_t off_us)
+{
+  int i;
+
+  for (i = 0; i < times; i++)
+    {
+      fireye_led(true);
+      usleep(on_us);
+      fireye_led(false);
+      usleep(off_us);
+    }
+}
+
+/* 早期忙等：此时调度器与系统节拍尚未就绪，不能用 usleep() */
+
+static void fireye_busy_wait(volatile uint32_t loops)
+{
+  while (loops-- > 0)
+    {
+    }
+}
+
+#if FIREYE_SELFTEST_UART
+
+/* 直接读写寄存器：板级代码里不方便引入 arm_internal.h，这里就地实现 */
+
+static uint32_t fireye_reg_read(uintptr_t addr)
+{
+  return *(volatile uint32_t *)addr;
+}
+
+static void fireye_reg_write(uintptr_t addr, uint32_t value)
+{
+  *(volatile uint32_t *)addr = value;
+}
+
+/* 直接操作 USART0 寄存器发送一个字节（不经过 NuttX 串口协议栈） */
+
+static void fireye_raw_putc(char ch)
+{
+  uintptr_t base = GD32_USART0_BASE;
+  uint32_t ctl0;
+
+  /* 只补 TEN 位，避免破坏控制台已经配置好的波特率/数据格式 */
+
+  ctl0 = fireye_reg_read(base + GD32_USART_CTL0_OFFSET);
+  if ((ctl0 & USART_CTL0_TEN) == 0)
+    {
+      fireye_reg_write(base + GD32_USART_CTL0_OFFSET, ctl0 | USART_CTL0_TEN);
+    }
+
+  while ((fireye_reg_read(base + GD32_USART_STAT0_OFFSET) & USART_STAT0_TBE) == 0)
+    {
+    }
+
+  fireye_reg_write(base + GD32_USART_DATA_OFFSET, (uint32_t)(uint8_t)ch);
+}
+
+static void fireye_raw_puts(const char *str)
+{
+  while (*str != '\0')
+    {
+      fireye_raw_putc(*str++);
+    }
+}
+
+/* 串口回环自检：PB6 与 PB7 短接时应能收全自己发出的数据 */
+
+static void fireye_loopback_test(void)
+{
+  uintptr_t base = GD32_USART0_BASE;
+  uint32_t ctl0 = fireye_reg_read(base + GD32_USART_CTL0_OFFSET);
+  int received = 0;
+  int round;
+  int guard;
+
+  /* 临时关掉接收中断，改由本线程轮询，避免数据被串口驱动取走 */
+
+  fireye_reg_write(base + GD32_USART_CTL0_OFFSET,
+                   (ctl0 | USART_CTL0_REN) & ~USART_CTL0_RBNEIE);
+
+  for (round = 0; round < 4; round++)
+    {
+      fireye_raw_puts(SELFTEST_LINE);
+
+      for (guard = 0; guard < 100; guard++)
+        {
+          if ((fireye_reg_read(base + GD32_USART_STAT0_OFFSET) &
+               USART_STAT0_RBNE) != 0)
+            {
+              (void)fireye_reg_read(base + GD32_USART_DATA_OFFSET);
+              received++;
+            }
+
+          usleep(1000);
+        }
+    }
+
+  /* 恢复原来的控制寄存器配置 */
+
+  fireye_reg_write(base + GD32_USART_CTL0_OFFSET, ctl0);
+
+  g_loopback_ok = (received >= SELFTEST_LINE_LEN);
+}
+
+#endif /* FIREYE_SELFTEST_UART */
+
+/* 心跳线程：LED 心跳 + 按键响应 + 原始串口输出 */
+
+static int fireye_selftest_thread(int argc, char *argv[])
+{
+  gd32_gpio_config(FIREYE_KEY_PIN);
+  gd32_gpio_config(FIREYE_LED_PIN);
+
+  /* 5 次快闪：表示已经跑到应用初始化阶段 */
+
+  fireye_led_flash(5, 100000, 100000);
+
+#if FIREYE_SELFTEST_UART
+  /* 串口回环自检（约 0.4s），成功则再极快闪 10 次 */
+
+  fireye_loopback_test();
+  if (g_loopback_ok)
+    {
+      fireye_led_flash(10, 30000, 30000);
+    }
+#endif
+
+  for (; ; )
+    {
+      if (!gd32_gpio_read(FIREYE_KEY_PIN))
+        {
+          /* 按键按下：5Hz 快闪 */
+
+          fireye_led(true);
+          usleep(100000);
+          fireye_led(false);
+          usleep(100000);
+        }
+      else
+        {
+          /* 正常心跳：1Hz */
+
+          fireye_led(true);
+          usleep(500000);
+          fireye_led(false);
+          usleep(500000);
+        }
+    }
+
+  return 0;  /* 不会执行到 */
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: gd32_selftest_early
+ *
+ * Description:
+ *   在板级早期初始化（gd32_boardinitialize）中调用，用 2 次快闪证明
+ *   时钟已经配置完成、固件没有卡在启动阶段。
+ *
+ ****************************************************************************/
+
+void gd32_selftest_early(void)
+{
+  int i;
+
+  gd32_gpio_config(FIREYE_LED_PIN);
+
+  for (i = 0; i < 2; i++)
+    {
+      fireye_led(true);
+      fireye_busy_wait(4000000);
+      fireye_led(false);
+      fireye_busy_wait(4000000);
+    }
+}
+
+/****************************************************************************
+ * Name: gd32_selftest_start
+ *
+ * Description:
+ *   启动心跳线程（在 gd32_bringup 末尾调用）。
+ *
+ * Returned Value:
+ *   成功返回非负的线程 PID，失败返回负的错误码。
+ *
+ ****************************************************************************/
+
+int gd32_selftest_start(void)
+{
+  return kthread_create("fireye_led", SELFTEST_THREAD_PRIO,
+                        SELFTEST_THREAD_STACK, fireye_selftest_thread, NULL);
+}
diff --git a/boards/gd32f4/gd32f470v_start/src/gd32f4xx_spi.c b/boards/gd32f4/gd32f470v_start/src/gd32f4xx_spi.c
