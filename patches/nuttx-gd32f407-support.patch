diff --git a/arch/arm/src/gd32f4/CMakeLists.txt b/arch/arm/src/gd32f4/CMakeLists.txt
new file mode 100644
index 00000000..674b7089
--- /dev/null
+++ b/arch/arm/src/gd32f4/CMakeLists.txt
@@ -0,0 +1,53 @@
+# ##############################################################################
+# arch/arm/src/gd32f4/CMakeLists.txt
+#
+# CMake build description for the GigaDevice GD32F4 chip.
+# Mirrors arch/arm/src/gd32f4/Make.defs and follows the same source list.
+# ##############################################################################
+
+set(SRCS
+  gd32f4xx_allocateheap.c
+  gd32f4xx_start.c
+  gd32f4xx_rcu.c
+  gd32f4xx_serial.c
+  gd32f4xx_lowputc.c
+  gd32f4xx_gpio.c
+  gd32f4xx_syscfg.c
+  gd32f4xx_irq.c
+  gd32f4xx_exti.c
+  gd32f4xx_dma.c
+  gd32f4xx_fmc.c
+  gd32f4xx_progmem.c
+)
+
+if(NOT CONFIG_SCHED_TICKLESS)
+  list(APPEND SRCS gd32f4xx_timerisr.c)
+else()
+  list(APPEND SRCS gd32f4xx_tickless.c)
+endif()
+
+if(NOT CONFIG_ARCH_IDLE_CUSTOM)
+  list(APPEND SRCS gd32f4xx_idle.c)
+endif()
+
+if(CONFIG_GD32F4_ENETMAC)
+  list(APPEND SRCS gd32f4xx_enet.c)
+endif()
+
+if(CONFIG_GD32F4_PMU)
+  list(APPEND SRCS gd32f4xx_pmu.c)
+endif()
+
+if(CONFIG_GD32F4_SPI)
+  list(APPEND SRCS gd32f4xx_spi.c)
+endif()
+
+if(CONFIG_GD32F4_I2C)
+  list(APPEND SRCS gd32f4xx_i2c.c)
+endif()
+
+if(CONFIG_GD32F4_SDIO)
+  list(APPEND SRCS gd32f4xx_sdio.c)
+endif()
+
+target_sources(arch PRIVATE ${SRCS})
