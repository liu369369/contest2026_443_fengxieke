<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.

    Team 443 (fengxieke): AI 硬件产品创新赛道。
    app/fireeye 为 NuttX 应用，映射到 packages/demos；
    app/fireeye_prototype 为 PC 端 Python 原型，不进编译树；
    app/hello_app 为官方样例，保留。
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_443_fengxieke" name="contest2026_443_fengxieke">
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_443_hello_app"/>
    <linkfile src="app/fireeye" dest="packages/demos/contest2026_443_fireeye"/>
  </project>
</manifest>
